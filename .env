# --- Blocks OIDC client (from: Blocks Cloud -> Core Services -> Authentication -> OIDC) ---

# The Client ID generated when you created the OIDC client in Blocks Cloud.
VITE_OIDC_CLIENT_ID=840dbe0e-1896-412d-b69c-a655a69ac788

# Must EXACTLY match the Redirect URL you registered on the OIDC client.
# VITE_OIDC_REDIRECT_URI=	https://dbpkwn-egyxi.slsblx.com/callback
VITE_OIDC_REDIRECT_URI=https://localhost:5174/callback

# The Well-Known URL generated alongside the Client ID/Secret when you
# created the OIDC client. Do NOT guess/construct this manually — use the
# exact value shown in the Blocks Cloud console, gateway path prefixes have
# changed between versions before (v1 vs v4) and guessing wastes a debug cycle.
VITE_OIDC_WELL_KNOWN_URL=https://iam.seliseblocks.com/Dd865d4b7e29a41148042684cc0b5d74b/.well-known/openid-configuration

# --- Project identification ---

# Found on the Environment Overview page in Blocks Cloud.
VITE_X_BLOCKS_KEY=Dd865d4b7e29a41148042684cc0b5d74b

# --- Optional: Blocks API gateway, only needed if you also call Blocks
# services (Data, Localization, etc.) directly from this app ---
VITE_BLOCKS_API_URL=https://api.seliseblocks.com
